# Free Google Gemini key: https://aistudio.google.com/apikey
# Copy this file to ".env" and put your real key after the "=".
# Never commit the .env file. The app also works without a key (it then
# shows the knowledge-base text directly instead of LLM advice).
LLM_API_KEY=

# Optional: force one Gemini model (otherwise a short list of free models is tried)
# LLM_MODEL=gemini-3.6-flash
